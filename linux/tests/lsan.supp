# LeakSanitizer suppressions for the ASan build (check.sh --asan): leaks in
# system libraries, not in 7-Zip or the port.

# fontconfig keeps font patterns that it never frees (no FcFini() at exit)
leak:libfontconfig.so

# xkbcommon keeps the keymap and compose tables of Qt's Wayland plugin
leak:libxkbcommon.so

# NautilusMenu and ThunarxMenu take a reference to each item that is
# appended, but do not drop it when they are finalized, so the items of
# every submenu of an extension leak (Nemo's menus free them)
leak:libnautilus-extension.so
leak:libthunarx-3.so
