[Desktop Entry]
Type=Application
Name=7-Zip File Manager
GenericName=Archive Manager
Comment=Browse, create and extract archives
Exec=7zFM %f
TryExec=7zFM
Icon=io.github.mikigal.SevenZip
Terminal=false
StartupNotify=true
Categories=Qt;Utility;Archiving;Compression;
Keywords=7z;zip;rar;tar;gzip;xz;archive;compress;extract;
MimeType=application/x-7z-compressed;application/zip;application/vnd.rar;application/vnd.ms-cab-compressed;application/vnd.efi.iso;application/x-xz;application/x-xz-compressed-tar;application/x-lzma;application/x-tar;application/x-cpio;application/x-bzip2;application/x-bzip2-compressed-tar;application/x-bzip1-compressed-tar;application/gzip;application/x-compressed-tar;application/x-compress;application/x-tarz;application/x-lha;application/x-rpm;application/vnd.debian.binary-package;application/x-arj;application/x-vhd-disk;application/x-vhdx-disk;application/x-ms-wim;application/x-apple-diskimage;application/x-xar;application/vnd.squashfs;application/zstd;application/x-zstd-compressed-tar;application/x-split-archive;application/x-ms-esd;application/x-fat-image;application/x-ntfs-image;application/x-hfs-image;application/x-apfs-image;
